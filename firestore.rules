rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /temoignages/{docId} {

      // N'importe qui peut ENVOYER un témoignage, avec des données valides :
      // - genre obligatoire, valeur Homme ou Femme
      // - texte obligatoire, non vide, limité à ~30 000 caractères (≈ 5000 mots)
      // - nom et whatsapp facultatifs (chaîne ou absent)
      // - createdAt doit être l'horodatage serveur (anti-triche sur les dates)
      allow create: if
        request.resource.data.genre in ['Homme', 'Femme'] &&
        request.resource.data.texte is string &&
        request.resource.data.texte.size() > 0 &&
        request.resource.data.texte.size() <= 30000 &&
        request.resource.data.createdAt == request.time;

      // Seul l'administrateur (connecté avec jaeweb001@gmail.com) peut LIRE
      // et SUPPRIMER les témoignages. Personne ne peut les modifier.
      allow read, delete: if request.auth != null
        && request.auth.token.email == 'jaeweb001@gmail.com';

      allow update: if false;
    }
  }
}
